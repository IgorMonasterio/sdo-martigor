# Cloudflare Pages headers (the public copy). Same policy as the nginx in the private copy;
# the one inline script (pins the dark theme) is allowed by its hash instead of a per-request nonce.
# Cloudflare Web Analytics (cookieless, injected at the edge for sdo. only) needs static.cloudflareinsights.com + cloudflareinsights.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BYT6Y04i5ycG/7WpQjK0vcajQxMqgFsjZdh2pQSQDf0=' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
/assets/*
  Cache-Control: public, max-age=31536000, immutable
